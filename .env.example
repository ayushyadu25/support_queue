# Copy this file to .env. Keep .env private and out of source control.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/prioritydesk?retryWrites=true&w=majority
PORT=5000

# Required before deploying. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# How often the server checks breached SLAs, in milliseconds (minimum 60 seconds).
ESCALATION_INTERVAL_MS=60000

# Optional: enables OpenAI-powered ordering when “AI triage” is selected.
# Keep this server-side only. Never place this value in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
